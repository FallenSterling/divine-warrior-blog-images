{%- comment -%}Fetch the menu artwork early (quietly, low priority) so the drop-down menu doesn't flicker when first opened{%- endcomment -%}
<link rel="preload" as="image" href="{{ 'dw-menu-bg-cream.jpg' | asset_url }}" media="(min-width: 990px)" fetchpriority="low">
{%- comment -%}Divine Warrior: paler parchment mega menu, tighter spacing, menus that use all the screen height below the header, and no decorative star line above the menu bar.{%- endcomment -%}
<style>
  /* Divine Warrior: stop the page sliding sideways on iPhone and iPad */
  html, body { max-width: 100%; overflow-x: clip; }
  /* Collection pages: keep Filter, Sort and product count inside the page margins */
  div:not(.facets-vertical) > #main-collection-filters.facets-wrapper { max-width: var(--page-width); margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; box-sizing: border-box; }
  @media screen and (min-width: 750px) { div:not(.facets-vertical) > #main-collection-filters.facets-wrapper { padding-left: 5rem; padding-right: 5rem; } }
</style>
<style>
  html:not(#dw) .section-header .header--top-center .header__inline-menu::before,
  html:not(#dw) .section-header.dw-compact .header--top-center .header__inline-menu::before { display: none !important; content: none !important; height: 0 !important; margin: 0 !important; }
  @media screen and (min-width: 990px) {
    html:not(#dw) .header__inline-menu .mega-menu__content {
      background-color: #f8f6f1;
      background-image: linear-gradient(rgba(248, 246, 241, .68), rgba(248, 246, 241, .68)), url("https://cdn.shopify.com/s/files/1/0959/6325/1070/files/IMG_5966.jpg?v=1794430777");
      max-height: var(--dw-mm-max, calc(100vh - 220px));
      padding-top: 20px; padding-bottom: 20px;
    }
    html:not(#dw) .header__inline-menu .mega-menu__content:not(#MegaMenu-Content-shop) {
      background-image: linear-gradient(rgba(248, 246, 241, .68), rgba(248, 246, 241, .68)), url("https://cdn.shopify.com/s/files/1/0959/6325/1070/files/IMG_5969.jpg?v=1794431111");
    }
    html:not(#dw) .header__inline-menu .dw-shop__tab { padding: 6px 12px; line-height: 1.22; margin-bottom: 1px; }
    html:not(#dw) .header__inline-menu .mega-menu__content .mega-menu__link { padding-top: 3px; padding-bottom: 3px; line-height: 1.25; }
    html:not(#dw) .header__inline-menu .dw-shop__groups { gap: 16px 34px; }
    html:not(#dw) .header__inline-menu .mega-menu__content .dw-shop__groups .mega-menu__link--level-2 { padding-bottom: 6px; margin-bottom: 4px; }
    html:not(#dw) .header__inline-menu .dw-shop__rail-all { margin-top: 8px; padding: 6px 12px; }
  }
</style>
<script>
  (function () {
    if (window.__dwMenuFit) return; window.__dwMenuFit = true;
    function fit() {
      var open = document.querySelectorAll('.header__inline-menu details[open] .mega-menu__content');
      for (var i = 0; i < open.length; i++) {
        var top = open[i].getBoundingClientRect().top;
        open[i].style.setProperty('--dw-mm-max', Math.max(320, window.innerHeight - top - 8) + 'px');
      }
    }
    document.addEventListener('toggle', function (e) {
      var t = e.target;
      if (t && t.matches && t.matches('.header__inline-menu details')) { requestAnimationFrame(fit); setTimeout(fit, 420); }
    }, true);
    window.addEventListener('resize', fit);
  })();
</script>

<style>
/* Divine Warrior: softer, paler drop-down menu (no hard lines) */
@media screen and (min-width:990px){
  html:not(#dw) .header__inline-menu .mega-menu__content{
    --dw-ink:#2e2620; --dw-gold:#a8875a; --dw-gold-soft:rgba(168,135,90,.2);
    background-color:#f5efe2;
    background-image:linear-gradient(90deg,rgba(245,239,226,0) 1%,rgba(245,239,226,.9) 13%,rgba(245,239,226,.84) 50%,rgba(245,239,226,.6) 72%,rgba(245,239,226,0) 86%),url({{ 'dw-menu-bg-cream.jpg' | asset_url }});
    border-top:0; box-shadow:0 16px 34px rgba(80,60,30,.07);
  }
  html:not(#dw) .header__inline-menu .mega-menu__content:not(#MegaMenu-Content-shop){
    background-image:linear-gradient(90deg,rgba(245,239,226,.15) 0%,rgba(245,239,226,.9) 14%,rgba(245,239,226,.9) 86%,rgba(245,239,226,.15) 100%),url({{ 'dw-menu-bg-cream.jpg' | asset_url }});
  }
  html:not(#dw) .header__inline-menu .mega-menu__content .mega-menu__link,
  html:not(#dw) .header__inline-menu .mega-menu__content .mega-menu__link--active{
    color:var(--dw-ink); font-weight:500; text-decoration:none;
    text-shadow:0 0 6px #f5efe2,0 0 3px #f5efe2,0 0 1px #f5efe2;
  }
  html:not(#dw) .header__inline-menu .mega-menu__content .mega-menu__link:hover{
    color:var(--dw-gold); text-decoration:none;
  }
  html:not(#dw) .header__inline-menu .mega-menu__content .dw-shop__groups .mega-menu__link--level-2{
    color:#86642f !important; font-weight:700; font-size:14px; letter-spacing:2.5px;
    text-shadow:0 0 6px #f5efe2,0 0 3px #f5efe2; border-bottom:0; padding-bottom:4px; margin-bottom:6px;
  }
  html:not(#dw) .header__inline-menu .mega-menu__content .dw-shop__groups .mega-menu__link--level-2:hover{color:#8a6c40 !important}
  html:not(#dw) .dw-shop__rail{border-right:0}
  html:not(#dw) .dw-shop__tab{color:var(--dw-ink); font-weight:500; text-shadow:0 0 6px #f5efe2,0 0 3px #f5efe2,0 0 1px #f5efe2}
  html:not(#dw) .dw-shop__tab.is-active{
    color:var(--dw-ink); font-weight:600; background:rgba(226,219,207,.5); box-shadow:none; border-radius:999px;
  }
  html:not(#dw) .dw-shop__rail-all{color:#86642f; font-weight:700; text-shadow:0 0 6px #f5efe2,0 0 3px #f5efe2; text-decoration:none; letter-spacing:2px}
  html:not(#dw) .dw-shop__all a{
    color:var(--dw-ink); border:1px solid rgba(168,135,90,.3); background:rgba(250,246,236,.9); box-shadow:none;
  }
  html:not(#dw) .dw-shop__all a:hover{background:rgba(226,219,207,.5)}
}
</style>
<style>
/* Divine Warrior: on shorter screens (like iPad), shrink the header while a drop-down menu is open,
   so the whole menu fits on screen without scrolling, and stop scrolling inside the menu from moving the page */
@media screen and (min-width:990px) and (max-height:950px){
  html:not(#dw) .section-header:has(.header__inline-menu details[open]) .header__heading-logo{max-width:58px!important}
  html:not(#dw) .section-header:has(.header__inline-menu details[open]) .header{padding-top:2px!important;padding-bottom:2px!important}
  html:not(#dw) .section-header:has(.header__inline-menu details[open]) .desktop-localization-wrapper{position:absolute;visibility:hidden;opacity:0;pointer-events:none}
  html:not(#dw) .section-header:has(.header__inline-menu details[open]) .header__menu-item{padding-top:4px;padding-bottom:6px}
  /* shrink the header instantly (no animation) when a menu opens, so the menu appears in one go */
  html:not(#dw) .section-header:has(.header__inline-menu details[open]),
  html:not(#dw) .section-header:has(.header__inline-menu details[open]) *{transition:none!important}
  html:not(#dw) .header__inline-menu .mega-menu__content{max-height:var(--dw-mm-max, calc(100vh - 130px))}
}
@media screen and (min-width:990px){
  html:not(#dw) .header__inline-menu .mega-menu__content{overscroll-behavior:contain}
}
</style>
<style>
/* Divine Warrior: slimmer cream announcement bar (no arrow), and a gently compact black header (option A) */
html:not(#dw) .announcement-bar__message .icon-arrow{display:none!important}
html:not(#dw) .announcement-bar__message{padding-top:.5rem;padding-bottom:.5rem;min-height:0}
html:not(#dw) .announcement-bar .slider-button{height:3rem}
html:not(#dw) .announcement-bar-slider .slider-button{height:3rem}
@media screen and (min-width:750px){
  html:not(#dw) .section-header .header__heading-logo{max-width:150px!important}
  html:not(#dw) .section-header .header{padding-top:6px!important;padding-bottom:4px!important}
  html:not(#dw) .section-header .header__menu-item{padding-top:6px;padding-bottom:10px}
}
</style>
<style>
/* Divine Warrior: warmer, soft linen page background instead of cool grey */
:root,
html:not(#dw) .color-scheme-1,
html:not(#dw) .color-scheme-87aeee60-3421-41ec-bfcf-fe31e11eec28,
html:not(#dw) .color-scheme-3e26d4b8-bc7e-475f-9579-3b10ab772209,
html:not(#dw) .color-scheme-66d4e28f-3df1-42ef-ad81-12554208192a{--color-background:245,240,232;--gradient-background:#f5f0e8}
html:not(#dw) body{background-color:#f5f0e8}
</style>
{%- if template.name == 'index' -%}
<style>
/* Divine Warrior: trim the top of the homepage hero slightly on iPad and computer */
@media screen and (min-width:750px){
  html:not(#dw) [id$="__image_banner"] .banner{min-height:470px!important}
  html:not(#dw) [id$="__image_banner"] .banner__media img{object-position:center bottom!important}
  html:not(#dw) [id$="__image_banner"] .banner__content{padding-top:2rem;padding-bottom:2rem}
}
</style>
{%- endif -%}
{%- if template.name == 'cart' -%}
<style>
/* Divine Warrior: pale cream cart page with the ivy, herbs and crystals artwork, like the menu */
html:not(#dw) cart-items.gradient,html:not(#dw) #main-cart-footer{--color-background:246,239,223;--gradient-background:#f6efdf;background:#f6efdf}
html:not(#dw) #main-cart-footer{background:#f6efdf url({{ 'dw-cart-art.jpg' | asset_url }}) center bottom/100% auto no-repeat;padding-bottom:clamp(110px,24vw,330px)}
html:not(#dw) cart-items .title-wrapper-with-link{align-items:flex-end}
html:not(#dw) cart-items .title-wrapper-with-link .title{font-size:0!important;line-height:1;margin:0}
html:not(#dw) cart-items .title-wrapper-with-link .title::before{content:"\2726\00a0\00a0Your sacred basket\00a0\00a0\2726";display:block;font-family:var(--font-body-family);font-size:1.7rem;line-height:1.4;letter-spacing:.3em;color:#86642f;text-transform:uppercase;margin:0}
html:not(#dw) cart-items .title-wrapper-with-link .underlined-link{color:#86642f}
html:not(#dw) cart-items:not(.is-empty) .cart__items{background:rgba(251,248,241,.85);border:1px solid #e2d6bf;border-radius:14px;padding:.4rem 2.4rem 1rem;box-shadow:0 6px 24px rgba(120,95,50,.08)}
html:not(#dw) .cart-items thead th{color:#86642f;font-weight:700;opacity:1}
html:not(#dw) .cart-items thead th,html:not(#dw) .cart-items thead{border-bottom:1px solid #e2d6bf}
html:not(#dw) .cart-item__image-container{border-radius:10px;overflow:hidden;border:1px solid #e2d6bf;background:#fff}
html:not(#dw) .cart-item__name{font-weight:600;color:#2e2620}
html:not(#dw) .cart-quantity.quantity{border-radius:999px;background:#fffdf8}
html:not(#dw) .cart-quantity.quantity:after{box-shadow:0 0 0 1px #c9b48a;border-radius:999px}
html:not(#dw) .cart-quantity.quantity:before{border-radius:999px}
html:not(#dw) cart-remove-button .button{color:#86642f}
html:not(#dw) .cart__note:after,html:not(#dw) .cart__note:before{display:none}
html:not(#dw) .cart__note .text-area{border:1px solid #c9b48a;border-radius:12px;background:rgba(255,253,248,.88)}
html:not(#dw) .cart__checkout-button{--color-button:51,49,46;--color-button-text:245,239,226;background:linear-gradient(180deg,#3a3835,#2d2b28)!important;color:#f5efe2!important;border-radius:999px;letter-spacing:.12em!important;font-size:1.7rem!important;font-weight:500!important;min-height:5rem;padding:.6rem 2rem;border:1.5px solid #b58f4a!important;box-shadow:0 6px 18px rgba(51,49,46,.22),inset 0 1px 0 rgba(216,184,120,.35);transition:transform .15s ease,box-shadow .15s ease}
html:not(#dw) .cart__checkout-button:after,html:not(#dw) .cart__checkout-button:before{box-shadow:none!important;border-radius:999px}
html:not(#dw) .cart__checkout-button:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(51,49,46,.3),inset 0 1px 0 rgba(216,184,120,.45)}
html:not(#dw) .cart__checkout-button::before{content:"\2726";position:static;display:inline-block;color:#d8b878;margin-right:1rem;font-size:1.3rem;letter-spacing:0;opacity:1;background:none;z-index:auto;inset:auto}
html:not(#dw) .cart__checkout-button::after{content:"\2726";position:static;display:inline-block;color:#d8b878;margin-left:1rem;font-size:1.3rem;letter-spacing:0;opacity:1;background:none;z-index:auto;inset:auto}
html:not(#dw) .cart__ctas{flex-wrap:wrap}
html:not(#dw) .cart__ctas::after{content:"Secure checkout \00b7  Packed with care";display:block;width:100%;text-align:center;font-size:1.5rem;letter-spacing:.06em;color:#86642f;margin-top:.8rem}
/* less white space between the basket, the total and the Checkout button */
html:not(#dw) cart-items:not(.is-empty)[class*="-padding"]{padding-bottom:.8rem!important}
html:not(#dw) #main-cart-footer .cart__footer{padding-top:1.6rem!important}
html:not(#dw) #main-cart-footer .totals{margin-top:.6rem}
html:not(#dw) #main-cart-footer .tax-note{font-size:1.25rem!important;line-height:1.4;margin:.3rem 0 .4rem!important;opacity:.85}
html:not(#dw) #main-cart-footer .cart__ctas{margin-top:.6rem!important}
@media screen and (max-width:749px){html:not(#dw) cart-items:not(.is-empty) .cart__items{padding:.4rem 1.2rem .8rem}}
