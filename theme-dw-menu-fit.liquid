<style>
/* Divine Warrior: show the top announcement bar on phones (an old theme rule hid every slider wrapper on mobile), without its arrows */
@media screen and (max-width:749px){
  html:not(#dw) .announcement-bar .announcement-bar-slider.slider-buttons{display:flex!important}
  html:not(#dw) .announcement-bar .announcement-bar-slider .slider-button{display:none!important}
}
</style>
