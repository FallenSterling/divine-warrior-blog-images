{%- comment -%}
Divine Warrior: reusable buying-guide page.
Hero, sticky section pills, product sections, "At a glance" Q&As, a "Which one?" chooser, FAQ and related reading.
Blocks render in order; consecutive glance / choice / faq blocks are grouped into one panel.
{%- endcomment -%}
{%- liquid
  assign hero_img = section.settings.hero_image
  if hero_img == blank
    for b in section.blocks
      if b.type == 'products' and b.settings.collection != blank and b.settings.collection.image != blank
        assign hero_img = b.settings.collection.image
        break
      endif
    endfor
  endif
  assign xmas_end = '2026-12-17' | date: '%s' | plus: 86399
  assign now_s = 'now' | date: '%s' | plus: 0
-%}
<style>
.dwg{--dwg-ink:#33312e;--dwg-gold:#86642f;--dwg-gold2:#b58f4a;--dwg-cream:#faf6ee;--dwg-line:#e6dcc8;--dwg-top:0px;color:var(--dwg-ink)}
.dwg *{box-sizing:border-box}
.dwg a{color:inherit}
.dwg__wrap{max-width:1200px;margin:0 auto;padding:0 1.6rem}
.dwg__hero{position:relative;height:250px;overflow:hidden;background:#efe6d3}
@media(min-width:750px){.dwg__hero{height:230px}}
.dwg__hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.dwg__hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(250,246,238,.96) 0%,rgba(250,246,238,.9) 45%,rgba(250,246,238,.35) 100%)}
@media(max-width:749px){.dwg__hero:after{background:linear-gradient(180deg,rgba(250,246,238,.82) 0%,rgba(250,246,238,.94) 100%)}}
.dwg__herotext{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;justify-content:center;max-width:1200px;margin:0 auto;padding:0 1.6rem}
.dwg__kicker{margin:0 0 .4rem;font-size:1.2rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dwg-gold)}
.dwg__h1{margin:0;font-size:clamp(2.5rem,4.2vw,3.8rem);line-height:1.1;color:var(--dwg-ink);max-width:60rem}
.dwg__lead{margin:.6rem 0 0;font-size:1.5rem;line-height:1.45;max-width:58rem;color:#4a4540;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.dwg__trust{margin:.7rem 0 0;font-size:1.25rem;color:var(--dwg-gold);letter-spacing:.02em}
@media(max-width:749px){.dwg__lead{font-size:1.4rem}.dwg__trust{font-size:1.15rem}}
.dwg__pills{position:sticky;top:var(--dwg-top);z-index:3;background:rgba(250,246,238,.97);border-bottom:1px solid var(--dwg-line);transition:top .2s}
.dwg__pillrow{display:flex;gap:.6rem;overflow-x:auto;padding:.9rem 1.6rem;max-width:1200px;margin:0 auto;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.dwg__pillrow::-webkit-scrollbar{display:none}
.dwg__pill{flex:0 0 auto;padding:.55rem 1.3rem;border:1px solid #cdb88f;border-radius:999px;font-size:1.3rem;text-decoration:none;white-space:nowrap;background:#fffdf8;color:var(--dwg-ink)}
.dwg__pill.is-on{background:var(--dwg-ink);border-color:var(--dwg-ink);color:#f5efe2}
.dwg__sec{padding:2.6rem 0 .6rem;scroll-margin-top:calc(var(--dwg-top) + 64px)}
.dwg__h2{margin:0 0 .4rem;font-size:clamp(2rem,2.8vw,2.6rem);color:var(--dwg-ink)}
.dwg__intro{margin:0 0 1.4rem;font-size:1.45rem;line-height:1.5;color:#4a4540;max-width:70rem}
.dwg__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;list-style:none;margin:0;padding:0}
@media(min-width:750px){.dwg__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.6rem}}
.dwg__card{display:flex;flex-direction:column;background:#fffdf8;border:1px solid var(--dwg-line);border-radius:14px;padding:.8rem;height:100%;text-decoration:none}
.dwg__img{aspect-ratio:1;border-radius:10px;overflow:hidden;background:#f4eee2}
.dwg__img img{width:100%;height:100%;object-fit:cover;display:block}
.dwg__t{margin:.8rem .2rem .3rem;font-size:1.35rem;line-height:1.35;flex:1;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.dwg__p{margin:0 .2rem .2rem;font-size:1.45rem;font-weight:600}
.dwg__all{display:table;margin:1.6rem auto 0;padding:.9rem 2.4rem;border:1px solid var(--dwg-gold2);border-radius:999px;font-size:1.4rem;text-decoration:none;color:var(--dwg-ink);background:#fffdf8}
.dwg__panel{background:var(--dwg-cream);border:1px solid var(--dwg-line);border-radius:18px;padding:2rem 1.6rem}
@media(min-width:750px){.dwg__panel{padding:2.6rem 2.8rem}}
.dwg__glance{display:grid;gap:.8rem}
@media(min-width:750px){.dwg__glance{grid-template-columns:1fr 1fr;gap:1.2rem 2.4rem}}
.dwg__q{border-bottom:1px solid var(--dwg-line);padding:.2rem 0 .8rem}
.dwg__q summary{cursor:pointer;list-style:none;font-size:1.55rem;font-weight:600;padding:.6rem 2.4rem .2rem 0;position:relative}
.dwg__q summary::-webkit-details-marker{display:none}
.dwg__q summary:after{content:"+";position:absolute;right:0;top:.4rem;font-size:2rem;color:var(--dwg-gold2);font-weight:400}
.dwg__q[open] summary:after{content:"\2013"}
.dwg__q p{margin:.4rem 0 0;font-size:1.4rem;line-height:1.55;color:#4a4540}
@media(min-width:750px){.dwg__glance .dwg__q summary{cursor:default;padding-right:0}.dwg__glance .dwg__q summary:after{display:none}}
.dwg__sw{display:flex;flex-wrap:wrap;gap:.6rem;margin:0 0 1.6rem}
.dwg__swb{display:flex;align-items:center;gap:.6rem;padding:.5rem 1.2rem .5rem .6rem;border:1px solid var(--dwg-line);border-radius:999px;background:#fffdf8;font:inherit;font-size:1.35rem;color:var(--dwg-ink);cursor:pointer}
.dwg__swb i{width:2rem;height:2rem;border-radius:50%;border:1px solid rgba(51,49,46,.25);display:block}
.dwg__swb[aria-selected=true]{border-color:var(--dwg-ink);box-shadow:0 0 0 1px var(--dwg-ink)}
.dwg__ch{display:none;grid-template-columns:1fr;gap:1.4rem;align-items:start}
.dwg__ch.is-on{display:grid}
@media(min-width:750px){.dwg__ch.is-on{grid-template-columns:1.1fr 1fr 1fr}}
.dwg__chh{margin:0 0 .4rem;font-size:2rem}
.dwg__chm{margin:0;font-size:1.45rem;line-height:1.55;color:#4a4540}
.dwg__chp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;grid-column:span 1}
@media(min-width:750px){.dwg__chp{grid-column:span 2}}
.dwg__faq .dwg__q summary{font-size:1.5rem}
.dwg__links{display:grid;gap:.8rem;list-style:none;margin:0;padding:0}
@media(min-width:750px){.dwg__links{grid-template-columns:1fr 1fr}}
.dwg__links a{display:block;padding:1.2rem 1.4rem;border:1px solid var(--dwg-line);border-radius:12px;background:#fffdf8;text-decoration:none;font-size:1.45rem}
.dwg__links a span{display:block;font-size:1.25rem;color:var(--dwg-gold);margin-top:.2rem}
.dwg__end{height:3rem}
</style>

<div class="dwg" data-dwg>
  <div class="dwg__hero">
    {%- if hero_img != blank -%}
      {{ hero_img | image_url: width: 1800 | image_tag: widths: '600,900,1200,1800', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- endif -%}
    <div class="dwg__herotext">
      {%- liquid
        assign show_x = false
        if section.settings.show_xmas and now_s <= xmas_end
          assign show_x = true
        endif
      -%}
      {%- if section.settings.kicker != blank or show_x -%}
        <p class="dwg__kicker">{{ section.settings.kicker }}{% if section.settings.kicker != blank and show_x %} &middot; {% endif %}{% if show_x %}Order by Thursday 17 December for Christmas{% endif %}</p>
      {%- endif -%}
      <h1 class="dwg__h1">{{ section.settings.title | default: page.title }}</h1>
      {%- if section.settings.lead != blank -%}<p class="dwg__lead">{{ section.settings.lead }}</p>{%- endif -%}
      {%- if section.settings.trust != blank -%}<p class="dwg__trust">{{ section.settings.trust }}</p>{%- endif -%}
    </div>
  </div>

  <nav class="dwg__pills" aria-label="On this page">
    <div class="dwg__pillrow">
      {%- assign seen = '' -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'products' -%}
          <a class="dwg__pill" href="#dwg-{{ b.id }}" data-dwg-pill="dwg-{{ b.id }}">{{ b.settings.pill | default: b.settings.heading }}</a>
        {%- else -%}
          {%- unless seen contains b.type -%}
            {%- assign seen = seen | append: b.type | append: ',' -%}
            {%- case b.type -%}
              {%- when 'glance' -%}<a class="dwg__pill" href="#dwg-glance" data-dwg-pill="dwg-glance">{{ section.settings.glance_pill }}</a>
              {%- when 'choice' -%}<a class="dwg__pill" href="#dwg-choice" data-dwg-pill="dwg-choice">{{ section.settings.chooser_pill }}</a>
              {%- when 'faq' -%}<a class="dwg__pill" href="#dwg-faq" data-dwg-pill="dwg-faq">FAQ</a>
              {%- when 'links' -%}<a class="dwg__pill" href="#dwg-links" data-dwg-pill="dwg-links">{{ section.settings.links_pill }}</a>
            {%- endcase -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>

  <div class="dwg__wrap">
  {%- assign open = '' -%}
  {%- assign first_choice = true -%}
  {%- for b in section.blocks -%}
    {%- if b.type != open and open != '' -%}
      {%- case open -%}
        {%- when 'glance' -%}</div></div></section>
        {%- when 'faq' -%}</div></div></section>
        {%- when 'choice' -%}</div></section>
        {%- when 'links' -%}</ul></div></section>
      {%- endcase -%}
      {%- assign open = '' -%}
    {%- endif -%}

    {%- case b.type -%}
      {%- when 'products' -%}
        {%- assign col = b.settings.collection -%}
        <section class="dwg__sec" id="dwg-{{ b.id }}" {{ b.shopify_attributes }}>
          <h2 class="dwg__h2">{{ b.settings.heading }}</h2>
          {%- if b.settings.intro != blank -%}<p class="dwg__intro">{{ b.settings.intro }}</p>{%- endif -%}
          {%- if col != blank -%}
            <ul class="dwg__grid">
              {%- assign shown = 0 -%}
              {%- for p in col.products -%}
                {%- if p.available and shown < b.settings.limit -%}
                  {%- assign shown = shown | plus: 1 -%}
                  <li><a class="dwg__card" href="{{ p.url }}">
                    <span class="dwg__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 480 | image_tag: widths: '240,360,480', sizes: '(min-width: 750px) 280px, 45vw', loading: 'lazy', alt: p.featured_image.alt | default: p.title }}{%- endif -%}</span>
                    <span class="dwg__t">{{ p.title }}</span>
                    <span class="dwg__p">{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
                  </a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            <a class="dwg__all" href="{{ col.url }}">Show all {{ col.products_count }} &rarr;</a>
          {%- endif -%}
        </section>

      {%- when 'glance' -%}
        {%- if open != 'glance' -%}
          {%- assign open = 'glance' -%}
          <section class="dwg__sec" id="dwg-glance"><div class="dwg__panel"><h2 class="dwg__h2">{{ section.settings.glance_heading }}</h2><div class="dwg__glance">
        {%- endif -%}
        <details class="dwg__q" data-dwg-glance {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><p>{{ b.settings.a }}</p></details>

      {%- when 'faq' -%}
        {%- if open != 'faq' -%}
          {%- assign open = 'faq' -%}
          <section class="dwg__sec dwg__faq" id="dwg-faq"><h2 class="dwg__h2">{{ section.settings.faq_heading }}</h2><div class="dwg__panel"><div>
        {%- endif -%}
        <details class="dwg__q" {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><p>{{ b.settings.a }}</p></details>

      {%- when 'choice' -%}
        {%- if open != 'choice' -%}
          {%- assign open = 'choice' -%}
          <section class="dwg__sec" id="dwg-choice"><div class="dwg__panel" data-dwg-chooser>
            <h2 class="dwg__h2">{{ section.settings.chooser_heading }}</h2>
            {%- if section.settings.chooser_intro != blank -%}<p class="dwg__intro">{{ section.settings.chooser_intro }}</p>{%- endif -%}
            <div class="dwg__sw" role="tablist" aria-label="{{ section.settings.chooser_heading | escape }}">
              {%- assign fi = true -%}
              {%- for c in section.blocks -%}{%- if c.type == 'choice' -%}
                <button type="button" class="dwg__swb" role="tab" aria-selected="{{ fi }}" aria-controls="dwg-ch-{{ c.id }}" data-dwg-sw="dwg-ch-{{ c.id }}"><i style="background:{{ c.settings.swatch }}"></i>{{ c.settings.name }}</button>
                {%- assign fi = false -%}
              {%- endif -%}{%- endfor -%}
            </div>
        {%- endif -%}
        <div class="dwg__ch{% if first_choice %} is-on{% endif %}" id="dwg-ch-{{ b.id }}" role="tabpanel" {{ b.shopify_attributes }}>
          {%- assign first_choice = false -%}
          <div><h3 class="dwg__chh">{{ b.settings.name }}</h3><p class="dwg__chm">{{ b.settings.meaning }}</p></div>
          <div class="dwg__chp">
            {%- assign picks = '' | split: '' -%}
            {%- if b.settings.product_1 != blank -%}{%- assign picks = picks | push: b.settings.product_1 -%}{%- endif -%}
            {%- if b.settings.product_2 != blank -%}{%- assign picks = picks | push: b.settings.product_2 -%}{%- endif -%}
            {%- for p in picks -%}
              <a class="dwg__card" href="{{ p.url }}">
                <span class="dwg__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 360 | image_tag: widths: '240,360', sizes: '(min-width: 750px) 240px, 45vw', loading: 'lazy', alt: p.featured_image.alt | default: p.title }}{%- endif -%}</span>
                <span class="dwg__t">{{ p.title }}</span>
                <span class="dwg__p">{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>

      {%- when 'links' -%}
        {%- if open != 'links' -%}
          {%- assign open = 'links' -%}
          <section class="dwg__sec" id="dwg-links"><h2 class="dwg__h2">{{ section.settings.links_heading }}</h2><div class="dwg__panel"><ul class="dwg__links">
        {%- endif -%}
        <li {{ b.shopify_attributes }}><a href="{{ b.settings.url }}">{{ b.settings.title }}{% if b.settings.note != blank %}<span>{{ b.settings.note }}</span>{% endif %}</a></li>
    {%- endcase -%}
  {%- endfor -%}
  {%- case open -%}
    {%- when 'glance' -%}</div></div></section>
    {%- when 'faq' -%}</div></div></section>
    {%- when 'choice' -%}</div></section>
    {%- when 'links' -%}</ul></div></section>
  {%- endcase -%}
  <div class="dwg__end"></div>
  </div>
</div>

{%- liquid
  assign faq_n = 0
  for b in section.blocks
    if b.type == 'glance' or b.type == 'faq'
      assign faq_n = faq_n | plus: 1
    endif
  endfor
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }}},
        {"@type": "ListItem", "position": 2, "name": {{ section.settings.title | default: page.title | json }}, "item": {{ shop.url | append: page.url | json }}}
      ]
    }{% if faq_n > 0 %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign k = 0 -%}
        {%- for b in section.blocks -%}{%- if b.type == 'glance' or b.type == 'faq' -%}
        {%- assign k = k | plus: 1 -%}
        {"@type": "Question", "name": {{ b.settings.q | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ b.settings.a | strip_html | json }}}}{% if k < faq_n %},{% endif %}
        {%- endif -%}{%- endfor -%}
      ]
    }{% endif %}
  ]
}
</script>

<script>
(function(){
  var root=document.querySelector('[data-dwg]');if(!root||root.__dwg)return;root.__dwg=true;
  var bar=root.querySelector('.dwg__pills'),row=root.querySelector('.dwg__pillrow');
  /* keep the pill row just under the sticky header */
  function hdr(){var h=document.querySelector('.section-header')||document.querySelector('sticky-header');if(!h)return 0;var r=h.getBoundingClientRect();return r.bottom>0&&getComputedStyle(h).position!=='static'?Math.max(0,Math.round(r.bottom)):0;}
  var ticking=false;function setTop(){ticking=false;root.style.setProperty('--dwg-top',hdr()+'px');}
  window.addEventListener('scroll',function(){if(!ticking){ticking=true;requestAnimationFrame(setTop);}},{passive:true});
  window.addEventListener('resize',setTop);setTop();
  /* highlight the current section */
  var pills=[].slice.call(root.querySelectorAll('[data-dwg-pill]'));
  function mark(id){pills.forEach(function(p){var on=p.getAttribute('data-dwg-pill')===id;p.classList.toggle('is-on',on);if(on){var l=p.offsetLeft-row.clientWidth/2+p.offsetWidth/2;row.scrollTo({left:l,behavior:'smooth'});}});}
  if('IntersectionObserver' in window){
    var vis={};var io=new IntersectionObserver(function(es){es.forEach(function(e){vis[e.target.id]=e.isIntersecting?e.boundingClientRect.top:null;});var best=null,bt=1e9;Object.keys(vis).forEach(function(k){if(vis[k]!==null&&Math.abs(vis[k])<bt){bt=Math.abs(vis[k]);best=k;}});if(best)mark(best);},{rootMargin:'-30% 0px -55% 0px'});
    pills.forEach(function(p){var s=document.getElementById(p.getAttribute('data-dwg-pill'));if(s)io.observe(s);});
  }
  /* At a glance: open on larger screens, tap to open on phones */
  var mq=window.matchMedia('(min-width: 750px)');
  function glance(){root.querySelectorAll('[data-dwg-glance]').forEach(function(d){if(mq.matches)d.setAttribute('open','');});}
  glance();if(mq.addEventListener)mq.addEventListener('change',glance);
  root.querySelectorAll('[data-dwg-glance] summary').forEach(function(s){s.addEventListener('click',function(e){if(mq.matches)e.preventDefault();});});
  /* chooser */
  root.querySelectorAll('[data-dwg-chooser]').forEach(function(ch){
    ch.addEventListener('click',function(e){var b=e.target.closest('[data-dwg-sw]');if(!b)return;
      ch.querySelectorAll('[data-dwg-sw]').forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false');});
      ch.querySelectorAll('.dwg__ch').forEach(function(p){p.classList.toggle('is-on',p.id===b.getAttribute('data-dwg-sw'));});});
  });
})();
</script>

{% schema %}
{
  "name": "DW buying guide",
  "settings": [
    {"type": "image_picker", "id": "hero_image", "label": "Hero image"},
    {"type": "text", "id": "kicker", "label": "Small line above the title"},
    {"type": "checkbox", "id": "show_xmas", "label": "Show Christmas order-by line (until 17 Dec)", "default": true},
    {"type": "text", "id": "title", "label": "Title (h1)"},
    {"type": "textarea", "id": "lead", "label": "Two-line lead"},
    {"type": "text", "id": "trust", "label": "Trust line"},
    {"type": "text", "id": "glance_pill", "label": "At a glance pill", "default": "At a glance"},
    {"type": "text", "id": "glance_heading", "label": "At a glance heading", "default": "At a glance"},
    {"type": "text", "id": "chooser_pill", "label": "Chooser pill", "default": "Which one?"},
    {"type": "text", "id": "chooser_heading", "label": "Chooser heading"},
    {"type": "textarea", "id": "chooser_intro", "label": "Chooser intro"},
    {"type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Questions, answered"},
    {"type": "text", "id": "links_pill", "label": "Reading pill", "default": "Further reading"},
    {"type": "text", "id": "links_heading", "label": "Reading heading", "default": "Further reading"}
  ],
  "blocks": [
    {"type": "products", "name": "Product section", "settings": [
      {"type": "text", "id": "pill", "label": "Pill label"},
      {"type": "text", "id": "heading", "label": "Heading"},
      {"type": "textarea", "id": "intro", "label": "Intro"},
      {"type": "collection", "id": "collection", "label": "Collection"},
      {"type": "range", "id": "limit", "label": "Products shown", "min": 4, "max": 16, "step": 4, "default": 8}
    ]},
    {"type": "glance", "name": "At a glance Q&A", "settings": [
      {"type": "text", "id": "q", "label": "Question"},
      {"type": "textarea", "id": "a", "label": "Answer"}
    ]},
    {"type": "choice", "name": "Chooser option", "settings": [
      {"type": "text", "id": "name", "label": "Name"},
      {"type": "color", "id": "swatch", "label": "Swatch colour", "default": "#ffffff"},
      {"type": "textarea", "id": "meaning", "label": "Meaning"},
      {"type": "product", "id": "product_1", "label": "Product 1"},
      {"type": "product", "id": "product_2", "label": "Product 2"}
    ]},
    {"type": "faq", "name": "FAQ", "settings": [
      {"type": "text", "id": "q", "label": "Question"},
      {"type": "textarea", "id": "a", "label": "Answer"}
    ]},
    {"type": "links", "name": "Reading link", "settings": [
      {"type": "text", "id": "title", "label": "Title"},
      {"type": "text", "id": "note", "label": "Short note"},
      {"type": "url", "id": "url", "label": "Link"}
    ]}
  ],
  "presets": [{"name": "DW buying guide"}]
}
{% endschema %}
