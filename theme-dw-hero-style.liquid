      var h='<div class="dwhs-fx" aria-hidden="true">';for(var i=0;i<22;i++)h+='<i>&#10022;</i>';for(var j=0;j<26;j++)h+='<b></b>';h+='</div>';
      var m=b.querySelector('.banner__media');if(m)m.insertAdjacentHTML('afterend',h);else b.insertAdjacentHTML('afterbegin',h);}
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',add);else add();
  document.addEventListener('shopify:section:load',add);
})();
</script>
